@misc{chapkovski_does_2021,
    abbr={SSRN},
	address = {Rochester, NY},
	type = {{SSRN} {Scholarly} {Paper}},
	title = {Does {Gamified} {Trading} {Stimulate} {Risk} {Taking}?},
	url = {https://papers.ssrn.com/abstract=3971868},
	html = {https://papers.ssrn.com/abstract=3971868},
	doi = {10.2139/ssrn.3971868},
	abstract = {We run a randomized online experiment to study the impact of trading platform gamification on retail traders' risk taking. We recruit 605 participants from four countries, two-thirds of them reporting self-directed trading experience, to trade a virtual asset on an experimental platform. The gamified version of the platform features elements such as achievement badges or encouragement messages. We find that gamification "nudges" participants to take on more risk, particularly when trading high-volatility assets. The effect is stronger for inexperienced traders with lower financial literacy. A one standard deviation increase in the financial literacy score reduces the impact of gamification by 56\%.},
	language = {en},
	urldate = {2022-12-22},
	author = {Chapkovski, Philipp and Khapko, Mariana and Zoican, Marius},
	month = nov,
	year = {2021},
	keywords = {experimental finance, financial literacy, gamification, retail trading, risk},
	file = {Full Text PDF:/Users/chapkovski/Zotero/storage/FZZ25ZTF/Chapkovski et al. - 2021 - Does Gamified Trading Stimulate Risk Taking.pdf:application/pdf},
}
